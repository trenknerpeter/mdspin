# Backend conversion API
BACKEND_URL=https://your-backend.vercel.app
BACKEND_API_KEY=your_64_char_api_key_here

# Supabase (get from supabase.com project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Make scenario webhook for cluster-brief synthesis (server-side only).
# NOTE: MAKE_BRIEF_SECRET must actually be set. app/api/brief/route.ts falls back to ""
# and still sends the x-mdspin-secret header, so an unset value means the brief webhook
# is effectively unauthenticated.
MAKE_BRIEF_WEBHOOK_URL=https://hook.eu2.make.com/your_webhook_id
MAKE_BRIEF_SECRET=your_shared_secret

# Make scenario webhook for per-doc summaries (server-side only).
# One document per call — the scenario accepts exactly one; see lib/vault/summary.ts.
# MAKE_SUMMARY_SECRET must actually be set: a blocked Make filter answers 200 "Accepted",
# so an unset secret makes every summary fail rather than erroring loudly.
MAKE_SUMMARY_WEBHOOK_URL=https://hook.eu2.make.com/your_webhook_id
MAKE_SUMMARY_SECRET=your_shared_secret

# Vercel Cron auth for the global embedding and summary backfills (server-side only).
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations
# of app/api/cron/embeddings/route.ts and app/api/cron/summaries/route.ts when this is set
# on the project (see vercel.json). Both routes 503 when it is unset and 401 when it is
# wrong — neither ever drains unauthenticated.
# Generate any long random value, e.g. `openssl rand -hex 32`, and set the SAME value in
# your Vercel project's environment variables.
CRON_SECRET=your_random_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# PostHog
NEXT_PUBLIC_POSTHOG_TOKEN=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Base URL used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=https://mdspin.app

# mdc-api base URL, read client-side by the Make OAuth consent page
NEXT_PUBLIC_API_URL=https://api.mdspin.app

# Stage 4: MCP write tools (create_document, append_to_document, update_document,
# organize_document, remove_from_vault). Ship "false", run the destruction drill against
# a local/preview deploy, then flip to "true". Write tools are not merely disabled but
# never registered on the McpServer when this isn't exactly "true" — they won't appear in
# a client's tools/list either.
MCP_WRITE_ENABLED=false
# Per-key daily write cap (create/append/update/organize/remove, combined). Defaults to
# 200 when unset or non-numeric.
MCP_WRITE_DAILY_LIMIT=200
